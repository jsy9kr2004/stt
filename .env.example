# 한국투자증권 KIS Open API
# https://apiportal.koreainvestment.com/ 에서 앱 등록 후 키 발급
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678-01

# 환경 모드: paper (모의투자) | live (실전)
KIS_ENV=paper

# 로깅 레벨: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 데이터 저장 루트 디렉토리
DATA_DIR=./data
